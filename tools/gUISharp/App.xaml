<Application
    x:Class="GUISharp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ModifiedDotInfoBadgeStyle"
                   TargetType="InfoBadge"
                   BasedOn="{StaticResource InformationalDotInfoBadgeStyle}">
                <Setter Property="Width"      Value="10" />
                <Setter Property="Height"     Value="10" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <local:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <local:BoolToTypeConverter              x:Key="BoolToTypeConverter" />
            <local:AppTypeGlyphConverter            x:Key="AppTypeGlyphConverter" />
            <local:HexToColorBrushConverter         x:Key="HexToColorBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
