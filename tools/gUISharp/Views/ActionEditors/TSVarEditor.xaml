<UserControl
    x:Class="GUISharp.Views.ActionEditors.TSVarEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">

    <StackPanel Spacing="12">
        <TextBlock Text="TSVar" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Variable Name">
            <TextBox Text="{Binding Variable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Value">
            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" MaxHeight="120" TextWrapping="Wrap" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Optional condition expression" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
