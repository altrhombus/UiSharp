<UserControl
    x:Class="GUISharp.Views.ActionEditors.TSVarEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">

    <StackPanel Spacing="12">
        <TextBlock Text="TSVar" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Creates a variable with the specified name and value. The value is evaluated as a VBScript expression; enclose in double-quotes or the value may be unexpectedly interpreted."
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <local:LabeledField Label="Variable Name">
            <TextBox Text="{Binding Variable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Value">
            <local:VariableAwareTextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True" InputMaxHeight="120" TextWrapping="Wrap" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <local:ConditionInputBox Text="{Binding Condition, Mode=TwoWay}" PlaceholderText="Optional condition expression" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
