<UserControl
    x:Class="GUISharp.Views.ActionEditors.VarsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">
    <StackPanel Spacing="12">
        <TextBlock Text="Vars" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Direction">
            <ComboBox ItemsSource="{Binding DirectionOptions}"
                      SelectedItem="{Binding Direction, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
        </local:LabeledField>
        <local:LabeledField Label="Filename">
            <TextBox Text="{Binding Filename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
