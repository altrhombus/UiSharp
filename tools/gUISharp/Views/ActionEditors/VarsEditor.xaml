<UserControl
    x:Class="GUISharp.Views.ActionEditors.VarsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">
    <StackPanel Spacing="12">
        <TextBlock Text="Vars" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Saves current variables to a data file or loads variables from a previously saved file. Useful for persisting values between UI++ executions, such as running before and inside a task sequence."
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <local:LabeledField Label="Direction">
            <ComboBox ItemsSource="{Binding DirectionOptions}"
                      SelectedItem="{Binding Direction, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
        </local:LabeledField>
        <local:LabeledField Label="Filename">
            <TextBox Text="{Binding Filename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <local:ConditionInputBox Text="{Binding Condition, Mode=TwoWay}" PlaceholderText="Optional" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
