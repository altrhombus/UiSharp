<UserControl
    x:Class="GUISharp.Views.ActionEditors.PreflightEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views"
    xmlns:vm="using:GUISharp.ViewModels.ActionEditors">
    <StackPanel Spacing="12">
        <TextBlock Text="Preflight" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Runs a series of VBScript conditions to validate the system before continuing. If any check fails, the user cannot proceed and UI++ returns error code 21 (ERROR_NOT_READY)."
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <local:LabeledField Label="Title">
            <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Timeout (seconds)">
            <TextBox Text="{Binding Timeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Timeout Action">
            <ComboBox ItemsSource="{Binding TimeoutActionOptions}" SelectedItem="{Binding TimeoutAction, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        </local:LabeledField>
        <CheckBox Content="Show On Failure Only" IsChecked="{Binding ShowOnFailureOnly, Mode=TwoWay}" />
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>

        <StackPanel Spacing="8">
            <TextBlock Text="Checks" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
            <StackPanel x:Name="ChecksPanel" Spacing="4" />
            <Button Content="+ Check" Command="{Binding AddCheckCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
