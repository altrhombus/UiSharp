<UserControl
    x:Class="GUISharp.Views.ActionEditors.UserAuthEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">
    <StackPanel Spacing="12">
        <TextBlock Text="UserAuth" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Title">
            <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Domain">
            <TextBox Text="{Binding Domain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="domain-fqdn.com" />
        </local:LabeledField>
        <local:LabeledField Label="Max Retry Count">
            <TextBox Text="{Binding MaxRetry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Required Group(s)">
            <TextBox Text="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Semicolon-separated AD groups (optional)" />
        </local:LabeledField>
        <CheckBox Content="Populate XAuthenticatedUserGroups" IsChecked="{Binding GetGroups, Mode=TwoWay}" />
        <CheckBox Content="Disable Cancel Button" IsChecked="{Binding DisableCancel, Mode=TwoWay}" />
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
