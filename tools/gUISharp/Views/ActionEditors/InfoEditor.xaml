<UserControl
    x:Class="GUISharp.Views.ActionEditors.InfoEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">
    <StackPanel Spacing="12">
        <TextBlock Text="Info" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Displays a message to the user. Supports an optional timeout with configurable dismiss behavior: continue to the next action, cancel, or return a custom error code."
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <local:LabeledField Label="Name">
            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
        <local:LabeledField Label="Title">
            <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:InfoMarkupEditor Text="{Binding MessageText, Mode=TwoWay}" />
        <CheckBox Content="Show Cancel Button" IsChecked="{Binding ShowCancel, Mode=TwoWay}" />
        <local:LabeledField Label="Timeout (seconds)">
            <TextBox Text="{Binding Timeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
        <local:LabeledField Label="Timeout Action">
            <ComboBox ItemsSource="{Binding TimeoutActionOptions}" SelectedItem="{Binding TimeoutAction, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
