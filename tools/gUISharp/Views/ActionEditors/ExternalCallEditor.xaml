<UserControl
    x:Class="GUISharp.Views.ActionEditors.ExternalCallEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">
    <StackPanel Spacing="12">
        <TextBlock Text="ExternalCall" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Command Line">
            <TextBox Text="{Binding CommandLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" MaxHeight="120" TextWrapping="Wrap" />
        </local:LabeledField>
        <local:LabeledField Label="Max Run Time (seconds)">
            <TextBox Text="{Binding MaxRunTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Exit Code Variable">
            <TextBox Text="{Binding ExitCodeVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
