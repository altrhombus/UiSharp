<UserControl
    x:Class="GUISharp.Views.ActionEditors.InputActionEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views"
    xmlns:vm="using:GUISharp.ViewModels.ActionEditors">
    <StackPanel Spacing="12">
        <TextBlock Text="Input" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Title">
            <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Size">
            <ComboBox ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding Size, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        </local:LabeledField>
        <CheckBox Content="Show Cancel Button" IsChecked="{Binding ShowCancel, Mode=TwoWay}" />
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>

        <StackPanel Spacing="8">
            <TextBlock Text="Input Fields" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="Fields are shown as raw XML. Edit the XML directly or use Add buttons to append new fields."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ListView ItemsSource="{Binding Fields}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:InputFieldItem">
                        <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="{x:Bind ElementName, Mode=OneWay}" />
                            </Expander.Header>
                            <TextBox Text="{x:Bind RawXml, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MaxHeight="200"
                                     FontFamily="Cascadia Mono, Consolas"
                                     TextWrapping="Wrap" />
                        </Expander>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="+ Text"     Command="{Binding AddTextFieldCommand}" />
                <Button Content="+ Choice"   Command="{Binding AddChoiceFieldCommand}" />
                <Button Content="+ Checkbox" Command="{Binding AddCheckboxFieldCommand}" />
                <Button Content="+ Info"     Command="{Binding AddInfoFieldCommand}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
