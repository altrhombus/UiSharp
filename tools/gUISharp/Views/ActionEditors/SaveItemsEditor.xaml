<UserControl
    x:Class="GUISharp.Views.ActionEditors.SaveItemsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">
    <StackPanel Spacing="12">
        <TextBlock Text="SaveItems" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Path">
            <TextBox Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Items (comma-separated)">
            <TextBox Text="{Binding Items, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="TSVariables,UILOG,C:\path\file.txt" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
