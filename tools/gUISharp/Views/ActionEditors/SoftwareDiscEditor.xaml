<UserControl
    x:Class="GUISharp.Views.ActionEditors.SoftwareDiscEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views"
    xmlns:vm="using:GUISharp.ViewModels.ActionEditors">
    <StackPanel Spacing="12">
        <TextBlock Text="SoftwareDiscovery" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
        <TextBlock Text="Software Matches" Style="{ThemeResource BodyStrongTextBlockStyle}" />
        <TextBlock Text="DisplayName is a case-insensitive regex matched against installed software."
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ListView x:Name="Editor" ItemsSource="{Binding Matches}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SoftwareMatchItem">
                    <Grid ColumnSpacing="8" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="DisplayName regex" />
                        <TextBox Grid.Column="1" Text="{x:Bind Variable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Variable" />
                        <TextBox Grid.Column="2" Text="{x:Bind Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Version (opt)" />
                        <TextBox Grid.Column="3" Text="{x:Bind VersionOperator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Operator" />
                        <Button Grid.Column="4" Content="&#xE74D;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Command="{Binding ElementName=Editor, Path=DataContext.RemoveMatchCommand}"
                                CommandParameter="{x:Bind}"
                                VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Content="+ Match" Command="{Binding AddMatchCommand}" />
    </StackPanel>
</UserControl>
