<UserControl
    x:Class="UiSharp.Editor.Views.ActionEditors.SoftwareDiscEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UiSharp.Editor.Views"
    xmlns:vm="using:UiSharp.Editor.ViewModels.ActionEditors">
    <StackPanel Spacing="12">
        <TextBlock Text="SoftwareDiscovery" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Checks Add/Remove Programs for installed software and sets a variable to True or False per match entry. Display names are matched with a case-insensitive regular expression."
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="Software Matches" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />

        <!-- Empty state -->
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="20,16"
                Visibility="{Binding HasMatches, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="No matches — add one below"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       HorizontalAlignment="Center" Opacity="0.6" />
        </Border>

        <!-- Column headers -->
        <Grid ColumnSpacing="8"
              Visibility="{Binding HasMatches, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Display Name (regex)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="Variable"             Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="Version"              Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="3" Text="Operator"             Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ListView x:Name="Editor" ItemsSource="{Binding Matches}" SelectionMode="None"
                  Visibility="{Binding HasMatches, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SoftwareMatchItem">
                    <Grid ColumnSpacing="8" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="1" Text="{x:Bind Variable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="2" Text="{x:Bind Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{x:Bind vm:SoftwareMatchItem.VersionOperatorOptions}"
                                  SelectedItem="{x:Bind VersionOperator, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <Button Grid.Column="4" Content="&#xE74D;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Command="{Binding ElementName=Editor, Path=DataContext.RemoveMatchCommand}"
                                CommandParameter="{x:Bind}"
                                VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Content="+ Match" Command="{Binding AddMatchCommand}" />
        <local:LabeledField Label="Condition">
            <local:ConditionInputBox Text="{Binding Condition, Mode=TwoWay}" PlaceholderText="Optional" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
