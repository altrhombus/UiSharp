<UserControl
    x:Class="GUISharp.Views.ActionEditors.TpmEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">
    <StackPanel Spacing="12">
        <TextBlock Text="TPM" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Performs a TPM management request (such as clearing or activating the chip) and optionally stores the result in a variable."
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <local:LabeledField Label="Request">
            <ComboBox ItemsSource="{Binding RequestOptions}"
                      SelectedItem="{Binding Request, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
        </local:LabeledField>
        <local:LabeledField Label="Variable">
            <TextBox Text="{Binding Variable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <local:ConditionInputBox Text="{Binding Condition, Mode=TwoWay}" PlaceholderText="Optional" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
