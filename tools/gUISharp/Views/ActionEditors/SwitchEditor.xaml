<UserControl
    x:Class="UiSharp.Editor.Views.ActionEditors.SwitchEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UiSharp.Editor.Views"
    xmlns:vm="using:UiSharp.Editor.ViewModels.ActionEditors">
    <StackPanel Spacing="12">
        <TextBlock Text="Switch" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Compares a value against a series of regular expression patterns in order; the first match sets the specified variables. Add a Default case to handle values that match no pattern."
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <local:LabeledField Label="On Value">
            <TextBox Text="{Binding OnValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <CheckBox Content="Don't Evaluate" IsChecked="{Binding DontEval, Mode=TwoWay}" />
        <local:LabeledField Label="Condition">
            <local:ConditionInputBox Text="{Binding Condition, Mode=TwoWay}" PlaceholderText="Optional" />
        </local:LabeledField>

        <TextBlock Text="Cases" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />

        <!-- Empty state for cases -->
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="20,24"
                Visibility="{Binding HasCases, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <FontIcon Glyph="&#xE748;" FontSize="20" Opacity="0.4" HorizontalAlignment="Center" />
                <TextBlock Text="No cases added yet"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center" Opacity="0.6" />
                <TextBlock Text="Add a case with a regex pattern to match against the On Value."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap" HorizontalAlignment="Center"
                           Opacity="0.6" MaxWidth="240" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Cases list -->
        <ListView x:Name="Editor"
                  ItemsSource="{Binding Cases}"
                  SelectionMode="None"
                  Visibility="{Binding HasCases, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SwitchCaseItem">
                    <!-- Grid wrapper keeps remove button always visible alongside the Expander -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Expander x:Name="CaseExpander" Grid.Column="0"
                                  HorizontalAlignment="Stretch" IsExpanded="True">
                            <Expander.Header>
                                <local:RegexInputBox Text="{x:Bind RegEx, Mode=TwoWay}"
                                                     PlaceholderText="RegEx pattern"
                                                     HorizontalAlignment="Stretch" />
                            </Expander.Header>
                            <StackPanel Spacing="8" Padding="0,4,0,4">
                                <local:LabeledField Label="Note">
                                    <TextBox Text="{x:Bind Comment, Mode=TwoWay}"
                                             PlaceholderText="XML comment for this case…"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="52" />
                                </local:LabeledField>
                                <ListView ItemsSource="{x:Bind Variables}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VariableAssignmentItem">
                                            <Grid ColumnSpacing="8" Padding="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Variable" />
                                                <TextBox Grid.Column="1" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Value" />
                                                <Button Grid.Column="2" Content="&#xE74D;"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        Command="{Binding ElementName=CaseExpander, Path=DataContext.RemoveVariableCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button Content="+ Variable" Command="{x:Bind AddVariableCommand}" />
                            </StackPanel>
                        </Expander>
                        <!-- Remove button: always visible in the row header area -->
                        <Button Grid.Column="1"
                                Content="&#xE74D;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Command="{Binding ElementName=Editor, Path=DataContext.RemoveCaseCommand}"
                                CommandParameter="{x:Bind}"
                                Width="32" Height="32" Padding="0"
                                VerticalAlignment="Top" Margin="4,2,0,0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Content="+ Case" Command="{Binding AddCaseCommand}" />

        <TextBlock Text="Default" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
        <TextBlock Text="Variables set when no case pattern matches."
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasDefaultVariables, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
        <ListView x:Name="DefaultVarsListView" ItemsSource="{Binding DefaultVariables}" SelectionMode="None"
                  Visibility="{Binding HasDefaultVariables, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:VariableAssignmentItem">
                    <Grid ColumnSpacing="8" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Variable" />
                        <TextBox Grid.Column="1" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Value" />
                        <Button Grid.Column="2" Content="&#xE74D;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Command="{Binding ElementName=DefaultVarsListView, Path=DataContext.RemoveDefaultVariableCommand}"
                                CommandParameter="{x:Bind}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Width="32" Height="32" Padding="0" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Content="+ Default Variable" Command="{Binding AddDefaultVariableCommand}" />
    </StackPanel>
</UserControl>
