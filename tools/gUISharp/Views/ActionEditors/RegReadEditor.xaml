<UserControl
    x:Class="GUISharp.Views.ActionEditors.RegReadEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">
    <StackPanel Spacing="12">
        <TextBlock Text="RegRead" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Hive">
            <ComboBox ItemsSource="{Binding HiveOptions}" SelectedItem="{Binding Hive, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        </local:LabeledField>
        <local:LabeledField Label="Key">
            <TextBox Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="SOFTWARE\Company\App" />
        </local:LabeledField>
        <local:LabeledField Label="Value Name">
            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Variable">
            <TextBox Text="{Binding Variable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <CheckBox Content="Use 64-bit Registry" IsChecked="{Binding Reg64, Mode=TwoWay}" />
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
