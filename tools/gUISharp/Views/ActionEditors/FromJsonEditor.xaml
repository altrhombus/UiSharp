<UserControl
    x:Class="UiSharp.Editor.Views.ActionEditors.FromJsonEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UiSharp.Editor.Views">
    <StackPanel Spacing="12">
        <TextBlock Text="FromJSON" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Parses inline JSON and populates variables from its key/value pairs. The JSON content is stored as the element value."
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <local:LabeledField Label="Source Variable">
            <TextBox Text="{Binding Variable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Variable containing the JSON to parse" />
        </local:LabeledField>
        <local:LabeledField Label="JSON Content">
            <TextBox Text="{Binding Json, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" MaxHeight="200" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <local:ConditionInputBox Text="{Binding Condition, Mode=TwoWay}" PlaceholderText="Optional" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
