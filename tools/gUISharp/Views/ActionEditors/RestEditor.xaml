<UserControl
    x:Class="GUISharp.Views.ActionEditors.RestEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">
    <StackPanel Spacing="12">
        <TextBlock Text="REST" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="URL">
            <TextBox Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Variable">
            <TextBox Text="{Binding Variable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="HTTP Method">
            <TextBox Text="{Binding Method, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="GET" />
        </local:LabeledField>
        <local:LabeledField Label="JSON Body">
            <TextBox Text="{Binding Json, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" MaxHeight="120" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
