<UserControl
    x:Class="UiSharp.Editor.Views.ActionEditors.ToJsonEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UiSharp.Editor.Views"
    xmlns:vm="using:UiSharp.Editor.ViewModels.ActionEditors">
    <StackPanel Spacing="12">
        <TextBlock Text="ToJSON" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Serializes a set of name/value attribute pairs into a JSON string and stores the result in a variable."
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <local:LabeledField Label="Variable">
            <TextBox Text="{Binding Variable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <local:ConditionInputBox Text="{Binding Condition, Mode=TwoWay}" PlaceholderText="Optional" />
        </local:LabeledField>

        <StackPanel Spacing="8">
            <TextBlock Text="Attributes" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
            <ListView x:Name="Editor" ItemsSource="{Binding Attributes}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:JsonAttributeItem">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{x:Bind Name,      Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name" />
                            <TextBox Grid.Column="1" Text="{x:Bind Value,     Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Value" />
                            <local:ConditionInputBox Grid.Column="2" Text="{x:Bind Condition, Mode=TwoWay}" PlaceholderText="Condition (opt)" />
                            <Button  Grid.Column="3" Content="&#xE74D;"
                                     FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                     Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                     Command="{Binding ElementName=Editor, Path=DataContext.RemoveAttributeCommand}"
                                     CommandParameter="{x:Bind}"
                                     VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Content="+ Attribute" Command="{Binding AddAttributeCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
