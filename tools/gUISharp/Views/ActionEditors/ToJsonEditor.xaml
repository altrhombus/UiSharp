<UserControl
    x:Class="GUISharp.Views.ActionEditors.ToJsonEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views"
    xmlns:vm="using:GUISharp.ViewModels.ActionEditors">
    <StackPanel Spacing="12">
        <TextBlock Text="ToJSON" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Variable">
            <TextBox Text="{Binding Variable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>

        <StackPanel Spacing="8">
            <TextBlock Text="Attributes" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ListView ItemsSource="{Binding Attributes}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:JsonAttributeItem">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{x:Bind Name,      Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name" />
                            <TextBox Grid.Column="1" Text="{x:Bind Value,     Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Value" />
                            <TextBox Grid.Column="2" Text="{x:Bind Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Condition (opt)" />
                            <Button  Grid.Column="3" Content="✕" Command="{Binding RemoveAttributeCommand, ElementName=Editor}" CommandParameter="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Content="+ Attribute" Command="{Binding AddAttributeCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
