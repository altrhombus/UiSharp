<UserControl
    x:Class="GUISharp.Views.ActionEditors.WmiWriteEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views"
    xmlns:vm="using:GUISharp.ViewModels.ActionEditors">
    <StackPanel Spacing="12">
        <TextBlock Text="WMIWrite" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Writes properties to a WMI class, creating the namespace and class if they do not exist. Mark a property as Key to identify the instance for updates."
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <local:LabeledField Label="Namespace">
            <TextBox Text="{Binding Namespace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="root\cimv2" />
        </local:LabeledField>
        <local:LabeledField Label="Class">
            <TextBox Text="{Binding Class, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Key Qualifier">
            <TextBox Text="{Binding KeyQualifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <local:ConditionInputBox Text="{Binding Condition, Mode=TwoWay}" PlaceholderText="Optional" />
        </local:LabeledField>
        <TextBlock Text="Properties" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />

        <!-- Empty state -->
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="20,16"
                Visibility="{Binding HasProperties, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="No properties — add one below"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       HorizontalAlignment="Center" Opacity="0.6" />
        </Border>

        <!-- Column headers -->
        <Grid ColumnSpacing="8"
              Visibility="{Binding HasProperties, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Name"     Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="CIM Type" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="Value"    Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ListView x:Name="Editor" ItemsSource="{Binding Properties}" SelectionMode="None"
                  Visibility="{Binding HasProperties, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:WmiPropertyItem">
                    <Grid ColumnSpacing="8" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ElementName=Editor, Path=DataContext.CimTypeOptions}"
                                  SelectedItem="{x:Bind CimType, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <TextBox Grid.Column="2" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Value" />
                        <CheckBox Grid.Column="3" Content="Key" IsChecked="{x:Bind IsKey, Mode=TwoWay}" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Content="&#xE74D;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Command="{Binding ElementName=Editor, Path=DataContext.RemovePropertyCommand}"
                                CommandParameter="{x:Bind}"
                                VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Content="+ Property" Command="{Binding AddPropertyCommand}" />
    </StackPanel>
</UserControl>
