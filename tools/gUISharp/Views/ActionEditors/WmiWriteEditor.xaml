<UserControl
    x:Class="GUISharp.Views.ActionEditors.WmiWriteEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views"
    xmlns:vm="using:GUISharp.ViewModels.ActionEditors">
    <StackPanel Spacing="12">
        <TextBlock Text="WMIWrite" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Namespace">
            <TextBox Text="{Binding Namespace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="root\cimv2" />
        </local:LabeledField>
        <local:LabeledField Label="Class">
            <TextBox Text="{Binding Class, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Key Qualifier">
            <TextBox Text="{Binding KeyQualifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
        <TextBlock Text="Properties" Style="{ThemeResource BodyStrongTextBlockStyle}" />
        <ListView x:Name="Editor" ItemsSource="{Binding Properties}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:WmiPropertyItem">
                    <Grid ColumnSpacing="8" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name" />
                        <TextBox Grid.Column="1" Text="{x:Bind CimType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="CIM_STRING" />
                        <TextBox Grid.Column="2" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Value" />
                        <CheckBox Grid.Column="3" Content="Key" IsChecked="{x:Bind IsKey, Mode=TwoWay}" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Content="&#xE74D;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Command="{Binding ElementName=Editor, Path=DataContext.RemovePropertyCommand}"
                                CommandParameter="{x:Bind}"
                                VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Content="+ Property" Command="{Binding AddPropertyCommand}" />
    </StackPanel>
</UserControl>
