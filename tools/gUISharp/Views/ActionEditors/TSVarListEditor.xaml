<UserControl
    x:Class="GUISharp.Views.ActionEditors.TSVarListEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views"
    xmlns:vm="using:GUISharp.ViewModels.ActionEditors">
    <StackPanel Spacing="12">
        <TextBlock Text="TSVarList" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Application Variable Base">
            <TextBox Text="{Binding AppVarBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Package Variable Base">
            <TextBox Text="{Binding PackageVarBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>

        <StackPanel Spacing="8">
            <TextBlock Text="Software References" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ListView ItemsSource="{Binding SoftwareRefs}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SoftwareRefItem">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{x:Bind Id,        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Software Id (GUID)" />
                            <TextBox Grid.Column="1" Text="{x:Bind Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Condition (opt)" />
                            <Button  Grid.Column="2" Content="✕" Command="{Binding RemoveRefCommand, ElementName=Editor}" CommandParameter="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Content="+ Reference" Command="{Binding AddRefCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
