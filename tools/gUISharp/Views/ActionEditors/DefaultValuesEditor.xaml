<UserControl
    x:Class="GUISharp.Views.ActionEditors.DefaultValuesEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">
    <StackPanel Spacing="12">
        <TextBlock Text="DefaultValues" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Value Types">
            <TextBox Text="{Binding ValueTypes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="All, or comma-separated: OS,Asset,VM,Domain,Net,TPM,Security,User,Mgmt" />
        </local:LabeledField>
        <CheckBox Content="Show Progress" IsChecked="{Binding ShowProgress, Mode=TwoWay}" />
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
    </StackPanel>
</UserControl>
