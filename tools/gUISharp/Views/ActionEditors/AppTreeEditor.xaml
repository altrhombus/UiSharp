<UserControl
    x:Class="GUISharp.Views.ActionEditors.AppTreeEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views"
    xmlns:vm="using:GUISharp.ViewModels.ActionEditors"
    xmlns:vmg="using:GUISharp.ViewModels">

    <UserControl.Resources>

        <!-- Shared ListView item style: no padding, stretch, no selection chrome -->
        <Style x:Key="AppTreeItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding"                      Value="0" />
            <Setter Property="Margin"                       Value="0,1" />
            <Setter Property="HorizontalContentAlignment"   Value="Stretch" />
            <Setter Property="Background"                   Value="Transparent" />
        </Style>

        <!-- ── SoftwareRef row ───────────────────────────────────────────── -->
        <DataTemplate x:Key="RefTemplate" x:DataType="vm:AppTreeRefItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,8">
                    <StackPanel Spacing="8">
                        <!-- Drag handle + software picker -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE784;"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="12" Opacity="0.35"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0" />
                            <local:LabeledField Grid.Column="1" Label="Software">
                                <ComboBox ItemsSource="{x:Bind Catalog}"
                                          SelectedItem="{x:Bind SelectedSoftware, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Select from catalog…">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vmg:SoftwareItemViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Id}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </local:LabeledField>
                        </Grid>

                        <!-- Unresolved ID warning -->
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    Visibility="{x:Bind IsUnresolved, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="12"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="ID not found in software catalog"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Flags -->
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="Default"  IsChecked="{x:Bind IsDefault,  Mode=TwoWay}"
                                      ToolTipService.ToolTip="Pre-selected when the dialog opens; the user can change it" />
                            <CheckBox Content="Required" IsChecked="{x:Bind IsRequired, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Always included; shown with a locked checkbox the user cannot deselect" />
                            <CheckBox Content="Hidden"   IsChecked="{x:Bind IsHidden,   Mode=TwoWay}"
                                      ToolTipService.ToolTip="Always included but not shown in the dialog — user never sees this item" />
                        </StackPanel>

                        <!-- Condition -->
                        <local:LabeledField Label="Condition">
                            <local:ConditionInputBox Text="{x:Bind Condition, Mode=TwoWay}"
                                                     PlaceholderText="e.g. %XRegion% = EMEA" />
                        </local:LabeledField>
                    </StackPanel>
                </Border>
                <Button Grid.Column="1"
                        Content="&#xE74D;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Width="32" Height="32" Padding="0"
                        VerticalAlignment="Top" Margin="4,2,0,0"
                        Tag="{x:Bind}"
                        Click="RemoveNodeButton_Click" />
            </Grid>
        </DataTemplate>

        <!-- ── SoftwareGroup expander ────────────────────────────────────── -->
        <DataTemplate x:Key="GroupTemplate" x:DataType="vm:AppTreeGroupItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Left accent border gives groups visual identity and depth cue -->
                <Border Grid.Column="0"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="0,4,4,0"
                        Opacity="0.7">
                    <Expander HorizontalAlignment="Stretch" IsExpanded="True">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE784;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="12" Opacity="0.35"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                <TextBox Grid.Column="1"
                                         Text="{x:Bind Label, Mode=TwoWay}"
                                         PlaceholderText="Group label"
                                         HorizontalAlignment="Stretch" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="8" Padding="4,4,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <CheckBox Content="Default"  IsChecked="{x:Bind IsDefault,  Mode=TwoWay}"
                                          ToolTipService.ToolTip="Pre-selected when the dialog opens; the user can change it" />
                                <CheckBox Content="Required" IsChecked="{x:Bind IsRequired, Mode=TwoWay}"
                                          ToolTipService.ToolTip="Always included; shown with a locked checkbox the user cannot deselect" />
                            </StackPanel>
                            <local:LabeledField Label="Condition">
                                <local:ConditionInputBox Text="{x:Bind Condition, Mode=TwoWay}"
                                                         PlaceholderText="e.g. %XRole% = Developer" />
                            </local:LabeledField>

                            <!-- Reorderable nested items -->
                            <ListView ItemsSource="{x:Bind Items}"
                                      ItemTemplateSelector="{StaticResource NodeSelector}"
                                      ItemContainerStyle="{StaticResource AppTreeItemContainerStyle}"
                                      CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                                      SelectionMode="None"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Command="{x:Bind AddRefCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="12"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        <TextBlock Text="Add Software" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind AddGroupCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="12"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        <TextBlock Text="Add Group" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>
                <Button Grid.Column="1"
                        Content="&#xE74D;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Width="32" Height="32" Padding="0"
                        VerticalAlignment="Top" Margin="4,2,0,0"
                        Tag="{x:Bind}"
                        Click="RemoveNodeButton_Click" />
            </Grid>
        </DataTemplate>

        <!-- Selector that picks the correct template per item type -->
        <local:AppTreeNodeTemplateSelector x:Key="NodeSelector"
                                           RefTemplate="{StaticResource RefTemplate}"
                                           GroupTemplate="{StaticResource GroupTemplate}" />
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <!-- P1: "AppTree" subtitle removed — guided panel header already shows "Guided — Application Tree" -->
        <TextBlock Text="Displays a tree of applications and packages for the user to choose. Sets numbered task sequence variables consumed by Install Application and Install Package steps. Only useful within a task sequence."
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <local:LabeledField Label="Title">
            <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <local:ConditionInputBox Text="{Binding Condition, Mode=TwoWay}" PlaceholderText="Optional" />
        </local:LabeledField>

        <!-- P3: AppVarBase/PackageVarBase collapsed by default — most configs use the defaults -->
        <Expander Header="Advanced Settings" IsExpanded="False">
            <StackPanel Spacing="8" Padding="0,8,0,4">
                <local:LabeledField Label="Application Variable Base">
                    <TextBox Text="{Binding AppVarBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </local:LabeledField>
                <local:LabeledField Label="Package Variable Base">
                    <TextBox Text="{Binding PackageVarBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </local:LabeledField>
            </StackPanel>
        </Expander>

        <!-- Software Sets -->
        <StackPanel Spacing="8">
            <TextBlock Text="Software Sets" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
            <TextBlock Text="Each set can be conditionally shown. Within a set, drag items to reorder, or use Add Software and Add Group to add entries."
                       TextWrapping="Wrap"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Empty state -->
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="20,24"
                    Visibility="{Binding HasSets, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xE7C9;" FontSize="20" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="No software sets"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center" Opacity="0.6" />
                    <TextBlock Text="Add a set to define which software is offered to the user."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               Opacity="0.6" MaxWidth="240" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Sets list -->
            <ItemsControl x:Name="SetsControl"
                          ItemsSource="{Binding Sets}"
                          Visibility="{Binding HasSets, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppTreeSetItem">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Expander Grid.Column="0" HorizontalAlignment="Stretch" IsExpanded="True">
                                <Expander.Header>
                                    <TextBox Text="{x:Bind Name, Mode=TwoWay}"
                                             PlaceholderText="Set name (e.g. Default)"
                                             HorizontalAlignment="Stretch" />
                                </Expander.Header>
                                <StackPanel Spacing="8" Padding="4,4,0,4">
                                    <local:LabeledField Label="Condition">
                                        <local:ConditionInputBox Text="{x:Bind Condition, Mode=TwoWay}"
                                                                 PlaceholderText="e.g. %XHardwareType% = Server" />
                                    </local:LabeledField>

                                    <!-- Reorderable items (refs and groups) -->
                                    <ListView ItemsSource="{x:Bind Items}"
                                              ItemTemplateSelector="{StaticResource NodeSelector}"
                                              ItemContainerStyle="{StaticResource AppTreeItemContainerStyle}"
                                              CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                                              SelectionMode="None"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Command="{x:Bind AddRefCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8EC;" FontSize="12"
                                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="Add Software" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{x:Bind AddGroupCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="12"
                                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="Add Group" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                            <!-- Remove set -->
                            <Button Grid.Column="1"
                                    Content="&#xE74D;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Command="{Binding ElementName=SetsControl, Path=DataContext.RemoveSetCommand}"
                                    CommandParameter="{x:Bind}"
                                    Width="32" Height="32" Padding="0"
                                    VerticalAlignment="Top" Margin="4,2,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Available to assign well -->
            <Expander IsExpanded="True"
                      HorizontalAlignment="Stretch"
                      Visibility="{Binding HasAvailableItems, Converter={StaticResource BoolToVisibilityConverter}}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Available to assign"
                                   VerticalAlignment="Center" />
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="10" Padding="7,1">
                            <TextBlock Text="{Binding AvailableToAssign.Count, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding AvailableToAssign}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vmg:SoftwareItemViewModel">
                            <Grid Padding="2,5" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="{x:Bind IsApplication, Mode=OneWay, Converter={StaticResource AppTypeGlyphConverter}}"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="13"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Label}"
                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Id}"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Tag="{x:Bind}"
                                        Click="AddToSetButton_Click"
                                        ToolTipService.ToolTip="Add to a set"
                                        Height="28" Padding="8,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Add to" FontSize="12" VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE70D;" FontSize="10"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <Button Content="Add Set" Command="{Binding AddSetCommand}" />
        </StackPanel>

        <!-- P8: Hyperlink replaces static hint text -->
        <HyperlinkButton Content="Manage software catalog →"
                         Command="{Binding GoToCatalogCommand}"
                         FontSize="12"
                         Padding="0" />
    </StackPanel>
</UserControl>
