<UserControl
    x:Class="GUISharp.Views.ActionEditors.AppTreeEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views">
    <StackPanel Spacing="12">
        <TextBlock Text="AppTree" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <local:LabeledField Label="Title">
            <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Application Variable Base">
            <TextBox Text="{Binding AppVarBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Package Variable Base">
            <TextBox Text="{Binding PackageVarBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </local:LabeledField>
        <local:LabeledField Label="Condition">
            <TextBox Text="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
        </local:LabeledField>
        <TextBlock Text="Software catalog is managed on the Software tab."
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
