<Page
    x:Name="PageRoot"
    x:Class="UiSharp.Editor.Views.ActionListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UiSharp.Editor.Views"
    NavigationCacheMode="Required"
    xmlns:vm="using:UiSharp.Editor.ViewModels"
    xmlns:editors="using:UiSharp.Editor.Views.ActionEditors"
    KeyDown="PageRoot_KeyDown">

    <Page.Resources>
        <!-- Per-type editor DataTemplates -->
        <DataTemplate x:Key="TSVarTemplate"         ><editors:TSVarEditor         DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="ExternalCallTemplate"  ><editors:ExternalCallEditor  DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="DefaultValuesTemplate" ><editors:DefaultValuesEditor DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="RandomStringTemplate"  ><editors:RandomStringEditor  DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="FileReadTemplate"      ><editors:FileReadEditor      DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="VarsTemplate"          ><editors:VarsEditor          DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="FromJsonTemplate"      ><editors:FromJsonEditor      DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="RestTemplate"          ><editors:RestEditor          DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="SaveItemsTemplate"     ><editors:SaveItemsEditor     DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="ToJsonTemplate"        ><editors:ToJsonEditor        DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="TSVarListTemplate"     ><editors:TSVarListEditor     DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="PreflightTemplate"     ><editors:PreflightEditor     DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="InputTemplate"         ><editors:InputActionEditor   DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="ActionGroupTemplate"   ><editors:ActionGroupEditor   DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="RawXmlTemplate"        ><editors:RawXmlEditor        DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="InfoTemplate"           ><editors:InfoEditor           DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="InfoFullScreenTemplate" ><editors:InfoFullScreenEditor DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="ErrorInfoTemplate"      ><editors:ErrorInfoEditor      DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="RegReadTemplate"        ><editors:RegReadEditor        DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="RegWriteTemplate"       ><editors:RegWriteEditor       DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="AppTreeTemplate"        ><editors:AppTreeEditor        DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="WmiReadTemplate"        ><editors:WmiReadEditor        DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="WmiWriteTemplate"       ><editors:WmiWriteEditor       DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="UserAuthTemplate"       ><editors:UserAuthEditor       DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="SoftwareDiscTemplate"   ><editors:SoftwareDiscEditor   DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="SwitchTemplate"         ><editors:SwitchEditor         DataContext="{Binding EditorViewModel}" /></DataTemplate>
        <DataTemplate x:Key="TpmTemplate"            ><editors:TpmEditor            DataContext="{Binding EditorViewModel}" /></DataTemplate>

        <local:ActionEditorTemplateSelector x:Key="EditorSelector"
            TSVarTemplate="{StaticResource TSVarTemplate}"
            ExternalCallTemplate="{StaticResource ExternalCallTemplate}"
            DefaultValuesTemplate="{StaticResource DefaultValuesTemplate}"
            RandomStringTemplate="{StaticResource RandomStringTemplate}"
            FileReadTemplate="{StaticResource FileReadTemplate}"
            VarsTemplate="{StaticResource VarsTemplate}"
            FromJsonTemplate="{StaticResource FromJsonTemplate}"
            RestTemplate="{StaticResource RestTemplate}"
            SaveItemsTemplate="{StaticResource SaveItemsTemplate}"
            ToJsonTemplate="{StaticResource ToJsonTemplate}"
            TSVarListTemplate="{StaticResource TSVarListTemplate}"
            PreflightTemplate="{StaticResource PreflightTemplate}"
            InputTemplate="{StaticResource InputTemplate}"
            ActionGroupTemplate="{StaticResource ActionGroupTemplate}"
            InfoTemplate="{StaticResource InfoTemplate}"
            InfoFullScreenTemplate="{StaticResource InfoFullScreenTemplate}"
            ErrorInfoTemplate="{StaticResource ErrorInfoTemplate}"
            RegReadTemplate="{StaticResource RegReadTemplate}"
            RegWriteTemplate="{StaticResource RegWriteTemplate}"
            AppTreeTemplate="{StaticResource AppTreeTemplate}"
            WmiReadTemplate="{StaticResource WmiReadTemplate}"
            WmiWriteTemplate="{StaticResource WmiWriteTemplate}"
            UserAuthTemplate="{StaticResource UserAuthTemplate}"
            SoftwareDiscTemplate="{StaticResource SoftwareDiscTemplate}"
            SwitchTemplate="{StaticResource SwitchTemplate}"
            TpmTemplate="{StaticResource TpmTemplate}"
            FallbackTemplate="{StaticResource RawXmlTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TreeCol" Width="340" MinWidth="200" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Left panel: action tree ──────────────────────────────────────── -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DropDownButton x:Name="AddButton" Grid.Row="0" Margin="8,8,8,4" HorizontalAlignment="Stretch">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add Action…" />
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <Flyout x:Name="AddFlyout" Placement="Bottom" Opening="AddFlyout_Opening">
                        <StackPanel Width="256" Spacing="0">
                            <TextBox x:Name="AddSearchBox"
                                     PlaceholderText="Search actions…"
                                     Margin="4,4,4,4"
                                     TextChanged="AddSearchBox_TextChanged"
                                     KeyDown="AddSearchBox_KeyDown" />
                            <Border Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <ScrollViewer MaxHeight="320" Padding="2,4,2,4">
                                <StackPanel x:Name="AddCatalogPanel" />
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <Grid Grid.Row="1" Margin="8,0,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         x:Name="SearchBox"
                         PlaceholderText="Search actions… (Ctrl+F)"
                         Text="{x:Bind ViewModel.ActionList.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchBox_KeyDown" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.ActionList.FilterSummary, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.ActionList.IsFiltering, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <TreeView Grid.Row="2" x:Name="ActionTreeView"
                      SelectionMode="Single"
                      ItemsSource="{x:Bind ViewModel.ActionList.ActionTree}"
                      SelectedItem="{x:Bind ViewModel.ActionList.SelectedAction, Mode=TwoWay}"
                      Margin="4,0"
                      CanDragItems="True"
                      CanReorderItems="True"
                      AllowDrop="True"
                      DragItemsCompleted="ActionTreeView_DragItemsCompleted"
                      KeyDown="ActionTreeView_KeyDown">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActionNodeViewModel">
                        <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="True">
                            <TreeViewItem.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Duplicate"
                                                    Command="{Binding ElementName=PageRoot, Path=ViewModel.ActionList.DuplicateActionCommand}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy as XML"
                                                    Click="CopyAsXml_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Export Group to File…"
                                                    Click="ExportGroupToFile_Click"
                                                    Visibility="{x:Bind IsGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Move Up"
                                                    Command="{Binding ElementName=PageRoot, Path=ViewModel.ActionList.MoveUpCommand}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Move Down"
                                                    Command="{Binding ElementName=PageRoot, Path=ViewModel.ActionList.MoveDownCommand}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete"
                                                    Click="RemoveAction_Click"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </TreeViewItem.ContextFlyout>
                            <TreeViewItem.Content>
                                <Grid Opacity="{x:Bind MatchOpacity, Mode=OneWay}"
                                      Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <InfoBadge Grid.Column="0"
                                               Style="{StaticResource ModifiedDotInfoBadgeStyle}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind IsDirty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                               ToolTipService.ToolTip="Unsaved changes" />
                                    <FontIcon Grid.Column="1"
                                              Glyph="{x:Bind ActionIcon}"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="14"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Grid.Column="2"
                                            Width="8" Height="8"
                                            CornerRadius="2"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind HasGroupColor, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{x:Bind GroupColor, Mode=OneWay, Converter={StaticResource HexToColorBrushConverter}}" />
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock FontWeight="{x:Bind LabelFontWeight}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind HighlightPrefix, Mode=OneWay}" />
                                            <Run Text="{x:Bind HighlightMatch,  Mode=OneWay}"
                                                 FontWeight="SemiBold"
                                                 Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <Run Text="{x:Bind HighlightSuffix, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind CommentDisplay, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontStyle="Italic"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind HasComment, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <Border CornerRadius="10"
                                                Padding="7,2"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind HasSummary, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind SummaryLabel, Mode=OneWay}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <Border CornerRadius="10"
                                                Padding="7,2"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind HasUnresolved, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind UnresolvedLabel, Mode=OneWay}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <FontIcon Grid.Column="5"
                                              Glyph="&#xE71C;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="11"
                                              VerticalAlignment="Center"
                                              Margin="4,0,0,0"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              Visibility="{x:Bind HasCondition, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                              ToolTipService.ToolTip="This action runs conditionally" />
                                    <FontIcon Grid.Column="6"
                                              Glyph="&#xE7BA;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="12"
                                              VerticalAlignment="Center"
                                              Margin="4,0,0,0"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                              Visibility="{x:Bind HasWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                              ToolTipService.ToolTip="{x:Bind WarningMessage, Mode=OneWay}" />
                                </Grid>
                            </TreeViewItem.Content>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,4,8,8" Spacing="4">
                <Button Command="{x:Bind ViewModel.ActionList.MoveUpCommand}" ToolTipService.ToolTip="Move Up">
                    <FontIcon Glyph="&#xE74A;" FontSize="14" />
                </Button>
                <Button Command="{x:Bind ViewModel.ActionList.MoveDownCommand}" ToolTipService.ToolTip="Move Down">
                    <FontIcon Glyph="&#xE74B;" FontSize="14" />
                </Button>
                <Button Command="{x:Bind ViewModel.ActionList.DuplicateActionCommand}" ToolTipService.ToolTip="Duplicate Action">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                </Button>
                <Button IsEnabled="{x:Bind ViewModel.ActionList.HasSelection, Mode=OneWay}"
                        Click="RemoveAction_Click"
                        ToolTipService.ToolTip="Remove Action"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tree resize splitter -->
        <Grid Grid.Column="1"
              Background="Transparent"
              PointerEntered="TreeSplitter_PointerEntered"
              PointerExited="TreeSplitter_PointerExited"
              PointerPressed="TreeSplitter_PointerPressed"
              PointerMoved="TreeSplitter_PointerMoved"
              PointerReleased="TreeSplitter_PointerReleased">
            <Border Width="1" HorizontalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Grid>

        <!-- ── Editor area: Guided | Splitter | XML ─────────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GuidedCol" Width="3*" MinWidth="0" />
                <ColumnDefinition x:Name="SplitterCol" Width="5" />
                <ColumnDefinition x:Name="XmlCol" Width="2*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- ── Guided panel ────────────────────────────────────────────── -->
            <Grid Grid.Column="0" x:Name="GuidedPanelGrid" GotFocus="GuidedPanel_GotFocus">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Guided header -->
                <Border x:Name="GuidedPanelHeader"
                        Grid.Row="0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.ActionList.GuidedPanelTitle, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <!-- Expand XML button (shown when XML panel is collapsed) -->
                        <Button x:Name="ExpandXmlBtn"
                                Grid.Column="1"
                                Width="28" Height="28" Padding="0"
                                Visibility="Collapsed"
                                Click="ExpandXmlBtn_Click"
                                ToolTipService.ToolTip="Show XML editor (Alt+X)">
                            <FontIcon Glyph="&#xE76C;" FontSize="11" />
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="X" Modifiers="Menu" />
                            </Button.KeyboardAccelerators>
                        </Button>

                        <!-- Collapse guided -->
                        <Button x:Name="CollapseGuidedBtn"
                                Grid.Column="2"
                                Width="28" Height="28" Padding="0"
                                Margin="0,0,3,0"
                                Click="CollapseGuidedBtn_Click"
                                ToolTipService.ToolTip="Collapse guided panel (Alt+G)">
                            <FontIcon Glyph="&#xE76B;" FontSize="11" />
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="G" Modifiers="Menu" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </Grid>
                </Border>

                <!-- Guided content -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Note / XML comment for this action -->
                    <Border Grid.Row="1" Padding="16,8,16,0"
                            Visibility="{x:Bind ViewModel.ActionList.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Note"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Column="1"
                                     PlaceholderText="XML comment shown in action tree…"
                                     Text="{x:Bind ViewModel.ActionList.SelectedAction.Comment, Mode=TwoWay, FallbackValue=''}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MaxHeight="160"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                    Visibility="{x:Bind ViewModel.ActionList.HasSelection, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}">
                            <FontIcon Glyph="&#xE8A5;" FontSize="48" Opacity="0.25" HorizontalAlignment="Center" />
                            <TextBlock Text="Select an action to edit" Opacity="0.4" HorizontalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer x:Name="GuidedScroller" Padding="16"
                                      Visibility="{x:Bind ViewModel.ActionList.HasSelection, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <ContentControl Content="{x:Bind ViewModel.ActionList.SelectedAction, Mode=OneWay}"
                                            ContentTemplateSelector="{StaticResource EditorSelector}"
                                            HorizontalContentAlignment="Stretch" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ── Drag splitter ───────────────────────────────────────────── -->
            <Border x:Name="DragSplitter"
                    Grid.Column="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    PointerEntered="DragSplitter_PointerEntered"
                    PointerExited="DragSplitter_PointerExited"
                    PointerPressed="DragSplitter_PointerPressed"
                    PointerMoved="DragSplitter_PointerMoved"
                    PointerReleased="DragSplitter_PointerReleased" />

            <!-- ── XML panel ───────────────────────────────────────────────── -->
            <Grid Grid.Column="2" x:Name="XmlPanelOuter">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- XML header -->
                <Border Grid.Row="0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Collapse XML -->
                        <Button x:Name="CollapseXmlBtn"
                                Grid.Column="0"
                                Width="28" Height="28" Padding="0"
                                Margin="3,0,0,0"
                                Click="CollapseXmlBtn_Click"
                                ToolTipService.ToolTip="Collapse XML panel (Alt+X)">
                            <FontIcon Glyph="&#xE76C;" FontSize="11" />
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="X" Modifiers="Menu" />
                            </Button.KeyboardAccelerators>
                        </Button>

                        <!-- Expand Guided button (shown when Guided panel is collapsed) -->
                        <Button x:Name="ExpandGuidedBtn"
                                Grid.Column="1"
                                Width="28" Height="28" Padding="0"
                                Visibility="Collapsed"
                                Click="ExpandGuidedBtn_Click"
                                ToolTipService.ToolTip="Show guided editor (Alt+G)">
                            <FontIcon Glyph="&#xE76B;" FontSize="11" />
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="G" Modifiers="Menu" />
                            </Button.KeyboardAccelerators>
                        </Button>

                        <TextBlock Grid.Column="2"
                                   Text="XML Editor"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- XML editor panel -->
                <local:XmlEditorPanel x:Name="XmlPanel"
                                      Grid.Row="1"
                                      PanelViewModel="{x:Bind ViewModel.ActionList, Mode=OneWay}"
                                      GotFocus="XmlPanel_GotFocus" />
            </Grid>
        </Grid>

        <!-- ── Welcome / first-run overlay ─────────────────────────────────── -->
        <Grid Grid.ColumnSpan="3"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Visibility="{x:Bind ViewModel.IsFileLoaded, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="28" MaxWidth="440" Margin="24,48,24,48">

                    <!-- Logo -->
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <FontIcon Glyph="&#xE8FD;" FontSize="52"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="gUI#"
                                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Visual editor for UI++ configuration files"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Action cards -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Stretch"
                                Padding="16,20" Command="{x:Bind ViewModel.NewCommand}">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8A5;" FontSize="28"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="New Configuration"
                                               TextAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Text="Start from a template"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch"
                                Padding="16,20" Command="{x:Bind ViewModel.OpenCommand}">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8E5;" FontSize="28"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Open Existing"
                                               TextAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Text="Open an XML config file"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Recent files -->
                    <StackPanel Spacing="8"
                                Visibility="{x:Bind ViewModel.HasRecentFiles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Recent Files"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ListView x:Name="WelcomeRecentList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  Loaded="WelcomeRecentList_Loaded"
                                  ItemClick="WelcomeOpenRecent_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RecentFileEntry">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Remove from list"
                                                                Tag="{x:Bind FullPath}"
                                                                Click="RemoveRecentItem_Click" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="13"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FullPath}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Cascading rename TeachingTip — anchored to guided panel header -->
        <TeachingTip x:Name="RenameTip"
                     Grid.ColumnSpan="3"
                     Title="Rename variable references?"
                     Subtitle="{x:Bind ViewModel.ActionList.PendingRenameMessage, Mode=OneWay}"
                     ActionButtonContent="Update All"
                     CloseButtonContent="Skip"
                     PreferredPlacement="BottomLeft"
                     IsLightDismissEnabled="False"
                     Target="{x:Bind GuidedPanelHeader}"
                     ActionButtonClick="RenameTip_ActionButtonClick"
                     CloseButtonClick="RenameTip_CloseButtonClick" />

    </Grid>
</Page>
