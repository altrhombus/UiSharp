<UserControl
    x:Class="UiSharp.Editor.Views.XmlEditorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Validation error bar -->
        <InfoBar x:Name="XmlErrorBar"
                 Grid.Row="0"
                 Severity="Error"
                 IsOpen="False"
                 IsClosable="False"
                 CornerRadius="0"
                 BorderThickness="0,0,0,1" />

        <!-- Monaco WebView2 -->
        <WebView2 x:Name="MonacoWebView"
                  Grid.Row="1"
                  Loaded="MonacoWebView_Loaded" />
    </Grid>
</UserControl>
