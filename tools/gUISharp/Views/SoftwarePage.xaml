<Page
    x:Class="GUISharp.Views.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views"
    xmlns:vm="using:GUISharp.ViewModels">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="GuidedCol" Width="3*" MinWidth="0" />
            <ColumnDefinition x:Name="SplitterCol" Width="5" />
            <ColumnDefinition x:Name="XmlCol" Width="2*" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <!-- Left: software list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Software section header -->
            <Border Grid.Row="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="6">
                    <TextBlock Text="Software"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <InfoBadge Style="{StaticResource InformationalDotInfoBadgeStyle}"
                               Visibility="{x:Bind ViewModel.SoftwareModified, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="8" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Command="{x:Bind ViewModel.Software.AddApplicationCommand}" Content="+ App"     />
                    <Button Command="{x:Bind ViewModel.Software.AddPackageCommand}"     Content="+ Package" />
                </StackPanel>
                <Button HorizontalAlignment="Stretch"
                        Content="Import from ConfigMgr…"
                        Click="ImportFromConfigMgr_Click" />
            </StackPanel>

            <!-- Empty state -->
            <Border Grid.Row="2" Margin="8"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="20,24"
                    Visibility="{x:Bind ViewModel.Software.HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}">
                <TextBlock Text="No software items — add an application or package above"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center" Opacity="0.6"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </Border>

            <ListView Grid.Row="2"
                      ItemsSource="{x:Bind ViewModel.Software.Items}"
                      SelectedItem="{x:Bind ViewModel.Software.SelectedItem, Mode=TwoWay}"
                      Visibility="{x:Bind ViewModel.Software.HasItems, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SoftwareItemViewModel">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Label, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind IsApplication, Converter={StaticResource BoolToTypeConverter}}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="3" Margin="8"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{x:Bind ViewModel.Software.HasSelection, Mode=OneWay}"
                    Click="RemoveItem_Click">
                Remove Selected
            </Button>
        </Grid>

        <!-- List/Guided divider -->
        <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- ── Guided panel ──────────────────────────────────────────────────── -->
        <Grid Grid.Column="2" x:Name="GuidedPanelGrid" GotFocus="GuidedPanel_GotFocus">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Guided header -->
            <Border Grid.Row="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Guided"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="ExpandXmlBtn"
                            Grid.Column="1"
                            Width="28" Height="28" Padding="0"
                            Visibility="Collapsed"
                            Click="ExpandXmlBtn_Click"
                            ToolTipService.ToolTip="Show XML editor">
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </Button>
                    <Button x:Name="CollapseGuidedBtn"
                            Grid.Column="2"
                            Width="28" Height="28" Padding="0"
                            Margin="0,0,3,0"
                            Click="CollapseGuidedBtn_Click"
                            ToolTipService.ToolTip="Collapse guided panel">
                        <FontIcon Glyph="&#xE76B;" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- Guided content -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Note / XML comment for this item -->
                <Border Grid.Row="0" Padding="16,8,16,0"
                        Visibility="{x:Bind ViewModel.Software.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Note"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox Grid.Column="1"
                                 PlaceholderText="XML comment shown in software list…"
                                 Text="{x:Bind ViewModel.Software.SelectedItem.Comment, Mode=TwoWay, FallbackValue=''}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="160"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind ViewModel.Software.HasSelection, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}">
                    <FontIcon Glyph="&#xE74C;" FontSize="48" Opacity="0.25" HorizontalAlignment="Center" />
                    <TextBlock Text="Select a software item to edit" Opacity="0.4" HorizontalAlignment="Center" />
                </StackPanel>
                <ScrollViewer Padding="16"
                              Visibility="{x:Bind ViewModel.Software.HasSelection, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel Spacing="12" MaxWidth="500">

                        <local:LabeledField Label="Id"
                            ToolTipService.ToolTip="A unique identifier within this config file — referenced by AppTree SoftwareRef elements. Can be any value as long as it is unique. A GUID is a common choice.">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{x:Bind ViewModel.Software.SelectedItem.Id, Mode=TwoWay, FallbackValue=''}"
                                         PlaceholderText="Any unique value, e.g. a GUID" />
                                <Button Grid.Column="1"
                                        Click="GenerateId_Click"
                                        ToolTipService.ToolTip="Generate a new GUID as the ID">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                </Button>
                            </Grid>
                        </local:LabeledField>
                        <local:LabeledField Label="Label">
                            <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.Label, Mode=TwoWay, FallbackValue=''}" />
                        </local:LabeledField>
                        <local:LabeledField Label="Info">
                            <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.Info, Mode=TwoWay, FallbackValue=''}" />
                        </local:LabeledField>
                        <local:LabeledField Label="Include IDs">
                            <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.IncludeIds, Mode=TwoWay, FallbackValue=''}" />
                        </local:LabeledField>
                        <local:LabeledField Label="Exclude IDs">
                            <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.ExcludeIds, Mode=TwoWay, FallbackValue=''}" />
                        </local:LabeledField>

                        <!-- Application-specific fields -->
                        <local:LabeledField Label="App Name"
                            ToolTipService.ToolTip="Must exactly match the Application name in ConfigMgr"
                            Visibility="{x:Bind ViewModel.Software.SelectedItem.IsApplication, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.AppName, Mode=TwoWay, FallbackValue=''}"
                                     PlaceholderText="ConfigMgr Application name (exact match)" />
                        </local:LabeledField>

                        <!-- Package-specific fields -->
                        <local:LabeledField Label="Package ID"
                            ToolTipService.ToolTip="Must exactly match the Package ID in ConfigMgr"
                            Visibility="{x:Bind ViewModel.Software.SelectedItem.IsApplication, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.PkgId, Mode=TwoWay, FallbackValue=''}"
                                     PlaceholderText="ConfigMgr Package ID (exact match)" />
                        </local:LabeledField>
                        <local:LabeledField Label="Program Name"
                            ToolTipService.ToolTip="Must exactly match the Program Name in ConfigMgr"
                            Visibility="{x:Bind ViewModel.Software.SelectedItem.IsApplication, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.ProgramName, Mode=TwoWay, FallbackValue=''}"
                                     PlaceholderText="ConfigMgr Program Name (exact match)" />
                        </local:LabeledField>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ── Drag splitter ─────────────────────────────────────────────────── -->
        <Border x:Name="DragSplitter"
                Grid.Column="3"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                PointerEntered="DragSplitter_PointerEntered"
                PointerExited="DragSplitter_PointerExited"
                PointerPressed="DragSplitter_PointerPressed"
                PointerMoved="DragSplitter_PointerMoved"
                PointerReleased="DragSplitter_PointerReleased" />

        <!-- ── XML panel ─────────────────────────────────────────────────────── -->
        <Grid Grid.Column="4" x:Name="XmlPanelOuter">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- XML header -->
            <Border Grid.Row="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CollapseXmlBtn"
                            Grid.Column="0"
                            Width="28" Height="28" Padding="0"
                            Margin="3,0,0,0"
                            Click="CollapseXmlBtn_Click"
                            ToolTipService.ToolTip="Collapse XML panel">
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </Button>
                    <Button x:Name="ExpandGuidedBtn"
                            Grid.Column="1"
                            Width="28" Height="28" Padding="0"
                            Visibility="Collapsed"
                            Click="ExpandGuidedBtn_Click"
                            ToolTipService.ToolTip="Show guided editor">
                        <FontIcon Glyph="&#xE76B;" FontSize="11" />
                    </Button>
                    <TextBlock Grid.Column="2"
                               Text="XML Editor"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- XML editor panel -->
            <local:XmlEditorPanel x:Name="XmlPanel"
                                  Grid.Row="1"
                                  PanelViewModel="{x:Bind ViewModel.Software, Mode=OneWay}"
                                  GotFocus="XmlPanel_GotFocus" />
        </Grid>
    </Grid>
</Page>
