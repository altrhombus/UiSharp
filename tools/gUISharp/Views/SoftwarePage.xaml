<Page
    x:Class="GUISharp.Views.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views"
    xmlns:vm="using:GUISharp.ViewModels">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: software list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="8" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Command="{x:Bind ViewModel.Software.AddApplicationCommand}" Content="+ App"     />
                    <Button Command="{x:Bind ViewModel.Software.AddPackageCommand}"     Content="+ Package" />
                </StackPanel>
                <Button HorizontalAlignment="Stretch"
                        Content="Import from ConfigMgr…"
                        Click="ImportFromConfigMgr_Click" />
            </StackPanel>

            <!-- Empty state -->
            <Border Grid.Row="1" Margin="8"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="20,24"
                    Visibility="{x:Bind ViewModel.Software.HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}">
                <TextBlock Text="No software items — add an application or package above"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center" Opacity="0.6"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </Border>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Software.Items}"
                      SelectedItem="{x:Bind ViewModel.Software.SelectedItem, Mode=TwoWay}"
                      Visibility="{x:Bind ViewModel.Software.HasItems, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SoftwareItemViewModel">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Label}" />
                            <TextBlock Text="{x:Bind IsApplication, Converter={StaticResource BoolToTypeConverter}}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="2" Margin="8"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{x:Bind ViewModel.Software.HasSelection, Mode=OneWay}"
                    Click="RemoveItem_Click">
                Remove Selected
            </Button>
        </Grid>

        <!-- Splitter -->
        <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Right: selected software detail -->
        <ScrollViewer Grid.Column="2" Padding="16">
            <StackPanel Spacing="12" MaxWidth="500"
                        Visibility="{x:Bind ViewModel.Software.HasSelection, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

                <local:LabeledField Label="Id">
                    <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.Id, Mode=TwoWay, FallbackValue=''}" />
                </local:LabeledField>
                <local:LabeledField Label="Label">
                    <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.Label, Mode=TwoWay, FallbackValue=''}" />
                </local:LabeledField>
                <local:LabeledField Label="Info">
                    <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.Info, Mode=TwoWay, FallbackValue=''}" />
                </local:LabeledField>
                <local:LabeledField Label="Include IDs">
                    <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.IncludeIds, Mode=TwoWay, FallbackValue=''}" />
                </local:LabeledField>
                <local:LabeledField Label="Exclude IDs">
                    <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.ExcludeIds, Mode=TwoWay, FallbackValue=''}" />
                </local:LabeledField>

                <!-- Application-specific fields -->
                <local:LabeledField Label="App Name (CM Application Name)"
                    Visibility="{x:Bind ViewModel.Software.SelectedItem.IsApplication, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.AppName, Mode=TwoWay, FallbackValue=''}" />
                </local:LabeledField>

                <!-- Package-specific fields -->
                <local:LabeledField Label="Package ID"
                    Visibility="{x:Bind ViewModel.Software.SelectedItem.IsApplication, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.PkgId, Mode=TwoWay, FallbackValue=''}" />
                </local:LabeledField>
                <local:LabeledField Label="Program Name"
                    Visibility="{x:Bind ViewModel.Software.SelectedItem.IsApplication, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBox Text="{x:Bind ViewModel.Software.SelectedItem.ProgramName, Mode=TwoWay, FallbackValue=''}" />
                </local:LabeledField>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
