<ContentDialog
    x:Class="GUISharp.Views.NewConfigWizardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GUISharp.Views"
    Title="New Configuration"
    PrimaryButtonText="Next"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    SecondaryButtonText="Back"
    IsSecondaryButtonEnabled="False"
    SecondaryButtonClick="Dialog_SecondaryButtonClick">

    <StackPanel Width="480" Spacing="0">

        <!-- ── Step 1: Choose scenario ───────────────────────────────────── -->
        <Grid x:Name="Step1Panel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="12"  />
                <ColumnDefinition Width="*"   />
            </Grid.ColumnDefinitions>

            <!-- Radio options -->
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Choose a starting point for your configuration."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />

                <RadioButton x:Name="RadioStandardOsd"
                             GroupName="Scenario" IsChecked="True"
                             HorizontalAlignment="Stretch"
                             Padding="12,8"
                             Checked="Radio_Checked">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Standard OSD" FontWeight="SemiBold" />
                        <TextBlock Text="Computer naming + software selection."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RadioSoftwareOnly"
                             GroupName="Scenario"
                             HorizontalAlignment="Stretch"
                             Padding="12,8"
                             Checked="Radio_Checked">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Software Selection" FontWeight="SemiBold" />
                        <TextBlock Text="App and package selection only."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RadioUserInfo"
                             GroupName="Scenario"
                             HorizontalAlignment="Stretch"
                             Padding="12,8"
                             Checked="Radio_Checked">
                    <StackPanel Spacing="2">
                        <TextBlock Text="User Info Capture" FontWeight="SemiBold" />
                        <TextBlock Text="Collect user-provided info via input dialog."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RadioBlank"
                             GroupName="Scenario"
                             HorizontalAlignment="Stretch"
                             Padding="12,8"
                             Checked="Radio_Checked">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Blank" FontWeight="SemiBold" />
                        <TextBlock Text="Start with an empty configuration."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- Preview panel -->
            <Border Grid.Column="2"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    VerticalAlignment="Stretch">
                <StackPanel Spacing="6">
                    <TextBlock Text="Actions this template creates"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="PreviewList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2">
                                    <TextBlock Text="•"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Step 2: Configure settings ───────────────────────────────── -->
        <StackPanel x:Name="Step2Panel" Visibility="Collapsed" Spacing="12">
            <TextBlock x:Name="Step2Subtitle"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <local:LabeledField Label="Configuration Title">
                <TextBox x:Name="TitleBox" PlaceholderText="e.g. Operating System Deployment" />
            </local:LabeledField>

            <!-- AppTree variable base fields (shown for OSD and Software Selection) -->
            <StackPanel x:Name="AppTreeSettings" Spacing="12">
                <local:LabeledField Label="Application Variable Base">
                    <TextBox x:Name="AppVarBaseBox" Text="XApplications" />
                </local:LabeledField>
                <local:LabeledField Label="Package Variable Base">
                    <TextBox x:Name="PkgVarBaseBox" Text="XPackages" />
                </local:LabeledField>
            </StackPanel>
        </StackPanel>

    </StackPanel>
</ContentDialog>
