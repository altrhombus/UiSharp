<Page
    x:Class="UiSharp.Editor.Views.PreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UiSharp.Editor.Views"
    Loaded="PreferencesPage_Loaded">

    <ScrollViewer Padding="24,20">
        <StackPanel MaxWidth="480" Spacing="28">

            <TextBlock Text="Preferences"
                       Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- Recent Files -->
            <StackPanel Spacing="12">
                <TextBlock Text="Recent Files"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Maximum recent files to remember"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <NumberBox x:Name="RecentFilesLimitBox"
                               Minimum="1" Maximum="20" SmallChange="1"
                               SpinButtonPlacementMode="Inline"
                               Width="120"
                               ValueChanged="RecentFilesLimit_ValueChanged" />
                </StackPanel>
            </StackPanel>

            <!-- ConfigMgr Connection -->
            <StackPanel Spacing="12">
                <TextBlock Text="ConfigMgr Connection"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Pre-configure the server used by the Software page's Import from ConfigMgr feature. These are saved automatically when you connect via the import dialog."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <local:LabeledField Label="AdminService Host">
                    <TextBox x:Name="ConfigMgrServerBox"
                             PlaceholderText="e.g. cm01.contoso.com"
                             TextChanged="ConfigMgrServer_TextChanged" />
                </local:LabeledField>
                <local:LabeledField Label="Site Code">
                    <TextBox x:Name="ConfigMgrSiteCodeBox"
                             PlaceholderText="e.g. P01"
                             MaxLength="3"
                             TextChanged="ConfigMgrSiteCode_TextChanged" />
                </local:LabeledField>
            </StackPanel>

            <!-- Default Editor Layout -->
            <StackPanel Spacing="12">
                <TextBlock Text="Default Editor Layout"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Starting panel arrangement when opening a page for the first time each session. You can still collapse or expand panels at any time using the panel header buttons."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <RadioButton x:Name="LayoutBoth"
                             Content="Guided + XML (default)"
                             GroupName="Layout"
                             IsChecked="True"
                             Checked="Layout_Checked" />
                <RadioButton x:Name="LayoutGuidedOnly"
                             Content="Guided panel only"
                             GroupName="Layout"
                             Checked="Layout_Checked" />
                <RadioButton x:Name="LayoutXmlOnly"
                             Content="XML panel only"
                             GroupName="Layout"
                             Checked="Layout_Checked" />
            </StackPanel>

            <!-- About -->
            <StackPanel Spacing="12">
                <TextBlock Text="About"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <StackPanel Spacing="4">
                    <TextBlock Text="gUI#"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="VersionText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Update check -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="UpdateProgress"
                                      Width="14" Height="14"
                                      IsActive="False"
                                      Visibility="Collapsed" />
                        <TextBlock x:Name="UpdateStatusText"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <HyperlinkButton x:Name="UpdateDownloadLink"
                                     Padding="0,2"
                                     Visibility="Collapsed" />
                </StackPanel>

                <TextBlock Text="A graphical editor for UI++/UiSharp XML configuration files. Part of the UiSharp project — a C# port of Jason Sandys's UI++ task-sequence front-end for Microsoft Configuration Manager."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap" />
                <StackPanel Spacing="2">
                    <HyperlinkButton Content="GitHub — altrhombus/UiSharp"
                                     NavigateUri="https://github.com/altrhombus/UiSharp"
                                     Padding="0,4" />
                    <HyperlinkButton Content="Original UI++ by Jason Sandys"
                                     NavigateUri="https://github.com/jason4tw/UIPlusPlus"
                                     Padding="0,4" />
                </StackPanel>
                <TextBlock Text="Licensed under the GNU General Public License v3.0."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
