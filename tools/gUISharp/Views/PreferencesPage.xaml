<Page
    x:Class="GUISharp.Views.PreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="PreferencesPage_Loaded">

    <ScrollViewer Padding="24,20">
        <StackPanel MaxWidth="480" Spacing="28">

            <TextBlock Text="Preferences"
                       Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- Recent Files -->
            <StackPanel Spacing="12">
                <TextBlock Text="Recent Files"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Maximum recent files to remember"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <NumberBox x:Name="RecentFilesLimitBox"
                               Minimum="1" Maximum="20" SmallChange="1"
                               SpinButtonPlacementMode="Inline"
                               Width="120"
                               ValueChanged="RecentFilesLimit_ValueChanged" />
                </StackPanel>
            </StackPanel>

            <!-- About -->
            <StackPanel Spacing="12">
                <TextBlock Text="About"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <StackPanel Spacing="4">
                    <TextBlock Text="gUI#"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="VersionText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
