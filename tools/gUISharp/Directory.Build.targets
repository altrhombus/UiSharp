<Project>
  <!-- WindowsAppSDK 2.0.x: route XamlCompiler.exe through a wrapper that eats the exit code.
       XamlCompiler.exe exits 1 on warnings-as-errors in Pass 2 even when output is valid;
       the wrapper forces exit 0 so MSBuild does not abort before reading output.json.
       Directory.Build.targets is imported after NuGet package targets, so XamlCompilerExePath
       is already set by the SDK here — capture it before overriding, then write the wrapper
       just-in-time so no machine-specific file needs to be checked in or pre-created. -->
  <PropertyGroup>
    <_RealXamlCompilerExePath>$(XamlCompilerExePath)</_RealXamlCompilerExePath>
    <XamlCompilerExePath>$(MSBuildThisFileDirectory)xamlcompiler-wrap.cmd</XamlCompilerExePath>
  </PropertyGroup>

  <Target Name="GenerateXamlCompilerWrap" BeforeTargets="MarkupCompilePass1">
    <ItemGroup>
      <_WrapLine Include="@echo off" />
      <_WrapLine Include="&quot;$(_RealXamlCompilerExePath)&quot; %25*" />
      <_WrapLine Include="exit /b 0" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(MSBuildThisFileDirectory)xamlcompiler-wrap.cmd"
      Lines="@(_WrapLine)"
      Overwrite="true" />
  </Target>

  <!-- Embed the short git commit hash into InformationalVersion as "1.0.0+abc1234".
       IgnoreExitCode keeps the build green when git is unavailable (CI without git, zip downloads). -->
  <Target Name="SetGitCommit" BeforeTargets="GetAssemblyVersion">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
    </Exec>
  </Target>

  <!-- WebView2Loader.dll ships in runtimes/win-<arch>/native/ but the OS DLL loader only
       searches the exe directory. Copy the correct architecture slice next to the exe so
       EnsureCoreWebView2Async can find it at runtime.
       This only runs when Platform is set explicitly (x64/x86/arm64); AnyCPU builds skip it. -->
  <Target Name="CopyWebView2Loader" AfterTargets="Build"
          Condition="'$(PlatformTarget)' != '' And '$(PlatformTarget)' != 'AnyCPU'">
    <PropertyGroup>
      <_WV2NativeDir>$(OutDir)runtimes\win-$(PlatformTarget)\native\</_WV2NativeDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_WV2NativeDir)WebView2Loader.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_WV2NativeDir)WebView2Loader.dll')" />
  </Target>
</Project>
